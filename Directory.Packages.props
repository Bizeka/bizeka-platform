<Project>
  <!-- Central package management. Add a version here before referencing a package; never pin versions in csproj files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <SerenityVersion Condition="'$(SerenityVersion)' == ''">10.6.3</SerenityVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Serenity.Demo.Northwind" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Extensions" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Corelib" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Net.Web" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Net.Services" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Net.Data" Version="$(SerenityVersion)" />
    <PackageVersion Include="Serenity.Net.Core" Version="$(SerenityVersion)" />
    <PackageVersion Include="FluentMigrator" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.SqlServer" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.MySql" Version="8.0.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>
</Project>
