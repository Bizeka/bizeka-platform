<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <RootNamespace>Bizeka.Demo</RootNamespace>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Bizeka.Demo</PackageId>
    <Version>0.1.3-alpha</Version>
    <Authors>Bizeka</Authors>
    <Company>Bizeka</Company>
    <Description>Open source demo and basic samples showcasing Bizeka platform modules on Serenity.</Description>
    <PackageTags>Serenity;Demo;Showcase;BasicSamples;Bizeka;OpenSource</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <StaticWebAssetBasePath>_content/$(PackageId)</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serenity.Corelib" />
    <PackageReference Include="Serenity.Extensions" />
    <PackageReference Include="Serenity.Net.Web" />
    <PackageReference Include="Serenity.Demo.Northwind" />
    <PackageReference Include="FluentMigrator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\bizeka.extensions\Bizeka.Extensions.csproj" />
    <ProjectReference Include="..\bizeka.dynamicforms\Bizeka.DynamicForms.csproj" />
    <ProjectReference Include="..\bizeka.todo\Bizeka.Todo.csproj" />
    <ProjectReference Include="..\bizeka.onlinechat\Bizeka.OnlineChat.csproj" />
    <ProjectReference Include="..\bizeka.theme\Bizeka.Theme.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Update="texts\resources\*.json" WithCulture="false" />
    <!-- Sample sources shown next to each sample (DemoSampleSources); generated server types are left out. -->
    <EmbeddedResource Include="Modules\**\*.cs;Modules\**\*.ts;Modules\**\*.tsx;Modules\**\*.css" Exclude="Modules\ServerTypes\**;Modules\index.ts;Modules\Shared\**" LogicalName="SampleSource/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <!-- Module sources shown with the Online Chat sample: the hub, the client connection and the host wiring. -->
    <EmbeddedResource Include="..\bizeka.onlinechat\Modules\OnlineChat\Services\ChatHub.cs;..\bizeka.onlinechat\Modules\OnlineChat\Services\OnlineChatServiceCollectionExtensions.cs;..\bizeka.onlinechat\Modules\OnlineChat\ChatPanel\ChatConnection.ts" LogicalName="SampleSource/OnlineChat/ChatPanel/@module/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <Target Name="NpmInstall" Condition="!Exists('node_modules\@serenity-is\tsbuild\package.json')">
    <Message Text="Installing NPM packages for $(ProjectName)..." Importance="high" />
    <Exec Command="npm ci --ignore-scripts" />
    <Exec Command="dotnet msbuild &quot;$(MSBuildProjectFullPath)&quot; -t:RestoreNodeTypes -p:Configuration=$(Configuration)" />
  </Target>

  <Target Name="RunTSBuild" BeforeTargets="BeforeBuild" DependsOnTargets="ResolveProjectReferences;RestoreNodeTypes;NpmInstall" Condition="'$(SkipTSBuild)' != 'true'">
    <Message Text="Executing TypeScript compiler for $(ProjectName)..." Importance="high" />
    <ItemGroup>
      <CleanedEsmFiles Include="wwwroot\esm\**" />
    </ItemGroup>
    <Exec Command="npm run build" />
    <ItemGroup>
      <CleanedEsmFiles Remove="wwwroot\esm\**" />
      <Content Remove="@(CleanedEsmFiles)" />
      <Content Include="wwwroot\esm\**\*.js;wwwroot\esm\**\*.css;wwwroot\esm\**\*.map" Exclude="@(Content)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
