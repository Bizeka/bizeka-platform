{
  "name": "@bizeka/theme",
  "version": "0.1.3-alpha",
  "description": "Token-driven Serene soft theme overrides for Serenity applications.",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "peerDependencies": {
    "@serenity-is/corelib": "10.6.3",
    "@serenity-is/domwise": "10.6.3",
    "@serenity-is/extensions": "10.6.3",
    "@serenity-is/sleekgrid": "10.6.3"
  },
  "scripts": {
    "build": "node ./tsbuild.js && tsc --noEmit && npm run build:package",
    "build:package": "npm run build:package:js && npm run build:package:types",
    "build:package:js": "node ./package.build.mjs",
    "build:package:types": "tsc -p ./tsconfig.package.json",
    "test:contract": "node ./tests/theme-contract.mjs",
    "test:hygiene": "node ./tests/theme-css-hygiene.mjs",
    "test:components": "node ./tests/theme-component-contract.mjs",
    "test:contrast": "node ./tests/theme-contrast.mjs",
    "test:contrast:strict": "node ./tests/theme-contrast.mjs --strict",
    "test:visual": "node ./tests/theme-visual.mjs",
    "test:visual:update": "node ./tests/theme-visual.mjs --update",
    "test:theme": "node ./tests/theme-suite.mjs",
    "test:theme:strict": "node ./tests/theme-suite.mjs --strict",
    "build:watch": "node ./tsbuild.js --watch",
    "pack:local": "npm pack",
    "tsc": "tsc",
    "prepack": "node ../../tools/Prepare-NpmPackage.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@serenity-is/tsbuild": "10.6.3",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "@serenity-is/corelib": "./node_modules/.dotnet/serenity.corelib",
    "@serenity-is/domwise": "./node_modules/.dotnet/serenity.domwise",
    "@serenity-is/extensions": "./node_modules/.dotnet/serenity.extensions",
    "@serenity-is/sleekgrid": "./node_modules/.dotnet/serenity.sleekgrid"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bizeka/bizeka-platform.git",
    "directory": "src/bizeka.theme"
  },
  "bugs": {
    "url": "https://github.com/Bizeka/bizeka-platform/issues"
  },
  "homepage": "https://github.com/Bizeka/bizeka-platform#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
